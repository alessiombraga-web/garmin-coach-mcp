# ---------------------------------------------------------------------------
# garmin-coach configuration. Copy to .env and edit.
# After editing .env run `docker compose up -d` (a plain restart does not reload it).
# ---------------------------------------------------------------------------

# Token Claude Desktop sends to the server. Generate one with: openssl rand -hex 32
MCP_TOKEN=change-me

# --- Data source: official Garmin Connect Personal API (READ-ONLY) ---------
# Create the key in Garmin Connect: Settings -> Personal API
# (https://connect.garmin.com/app/settings/personalApiToken). It expires after
# the period you choose (30 days to 1 year): create a new one when it does.
GARMIN_PERSONAL_API_KEY=

# --- Optional: write access via the community module ------------------------
# The official API is read-only. To let Claude create and schedule workouts on
# your Garmin, enable the community module (python-garminconnect, unofficial
# API) and log in once: see README, "Write access (optional)".
ENABLE_GARMINCONNECT=false
# Optional credentials for automatic re-login when its tokens expire
# (not usable with MFA: re-login must be interactive).
# GARMIN_EMAIL=
# GARMIN_PASSWORD=

# --- Sync --------------------------------------------------------------------
# Your timezone (used for "today" and log timestamps)
TZ=Europe/Rome

# First import: fetch history from this date on
BACKFILL_FROM=2024-01-01

# Background sync every N minutes (0 = only when Claude asks)
SYNC_INTERVAL_MIN=30

# Pause between Garmin requests, in seconds
REQUEST_DELAY_S=1.5

# Activity types (substring of Garmin typeKey) for which FIT, laps and
# per-second records are downloaded. "all" = every sport; e.g. "run,cycling".
DETAIL_TYPE_MATCH=all

# --- Analysis ------------------------------------------------------------------
# Starting heart-rate zones for "time in zone": bpm where zones 2..N begin.
# Example below = Z1 <135 | Z2 135-149 | Z3 150-159 | Z4 160-169 | Z5 >=170. Set your own.
# New zones told to Claude in chat (e.g. after a test) apply from their date on.
HR_BANDS=135,150,160,170
